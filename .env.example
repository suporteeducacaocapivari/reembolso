# ==============================================================================
# VARIÁVEIS DE AMBIENTE - SEMEC CAPIVARI (REEMBOLSO TRANSPORTE ESCOLAR)
# Copie este arquivo para .env.local (desenvolvimento) ou configure no Coolify
# ==============================================================================

# URL da API do Supabase (Self-Hosted no Coolify ou Cloud)
VITE_SUPABASE_URL=https://sua-instancia-supabase.semec.portoedu.com.br

# Chave pública (anon key) do Supabase
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# Chave da API do Google Gemini (para OCR de NF-e, Cupom Fiscal e BP-e)
VITE_GEMINI_API_KEY=sua_chave_gemini_aqui
